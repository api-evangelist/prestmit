  "info": {
    "_postman_id": "3457b051-82de-4e66-b463-e8e3c1b8051a",
    "name": "Prestmit Partner Bank Accounts Gift Cards - Buy API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Prestmit Partner API allows developers to automate buying and selling of\ngift cards, manage wallet balances and payouts, and integrate Prestmit\ntransactions into their own applications. Authentication is performed via an\nx-api-key header, with optional IP whitelisting. A sandbox environment is\navailable for development.\n\n\nContact Support:\n Name: Prestmit Developer Support",
      "type": "text/plain"
    }
  }
